# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan

# Terraform crash/debug logs
crash.log
crash.*.log
debug.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Editor temporary files
*.swp
*.swo

# Track the non-sensitive dev inputs required by CI
!infra/dev/terraform.tfvars

# Temporary OIDC policy drafts
.tmp/

# Generated Terraform plan JSON (may contain sensitive values)
infra/dev/dev-plan.json
